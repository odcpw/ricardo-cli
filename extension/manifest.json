{
  "manifest_version": 3,
  "name": "Ricardo CLI Browser Bridge",
  "version": "0.3.0",
  "description": "Read Ricardo and Tutti listings, photos and your seller orders, drafts and counts through your browser without exporting cookies.",
  "permissions": [
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "https://www.ricardo.ch/*",
    "https://www.tutti.ch/*",
    "https://img.ricardostatic.ch/*",
    "https://c.tutti.ch/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ricardo CLI"
  }
}
