{
  "manifest_version": 3,
  "name": "Ricardo CLI Browser Bridge",
  "version": "0.1.0",
  "description": "Read Ricardo through your existing browser session without exporting cookies.",
  "permissions": [
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "https://www.ricardo.ch/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ricardo CLI"
  }
}
